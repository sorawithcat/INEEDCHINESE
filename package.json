{
  "name": "ineedchinese",
  "version": "0.5.0",
  "private": true,
  "description": "将应用和游戏文本实时翻译为简体中文的桌面工具",
  "author": "sorawithcat",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "setup:textractor": "node scripts/fetch-textractor.mjs",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tesseract.js": "6.0.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "wait-on": "9.0.10"
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.sorawithcat.ineedchinese",
    "productName": "INEEDCHINESE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/textractor", "to": "textractor" }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js-core/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
